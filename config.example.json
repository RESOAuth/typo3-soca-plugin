{
  "origin": "https://app.example.com",
  "client_name": "Example application",
  "issuer": "https://auth.resoauth.cloud",
  "enabled": false,
  "private_key_file": "/run/secrets/soca-client.pem",
  "state_key_file": "/run/secrets/soca-state.key",
  "metadata_mode": "hosted",
  "proxy_template": "https://dynamic-cimd.resoauth.cloud/cimd/%s",
  "allowed_domains": [
    "example.com"
  ],
  "allowed_emails": [],
  "denied_domains": [],
  "denied_emails": [],
  "provision": false,
  "group_id": "1",
  "site_id": "main",
  "session_max_age": 900,
  "storage_pid": 2
}
